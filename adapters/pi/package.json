{
  "name": "pi-mmx",
  "version": "0.2.0",
  "description": "Sketch with pi in the same Mermaid diagram: you edit the picture in the mmx cockpit, pi sees exactly what you changed and answers in the diagram.",
  "license": "MIT",
  "author": "Eastsidegunn",
  "homepage": "https://github.com/Eastsidegunn/mmx/tree/main/adapters/pi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eastsidegunn/mmx.git",
    "directory": "adapters/pi"
  },
  "bugs": {
    "url": "https://github.com/Eastsidegunn/mmx/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "mmx",
    "mermaid",
    "diagram",
    "coding-agent"
  ],
  "type": "module",
  "files": [
    "index.ts",
    "turns.ts",
    "pending.ts",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/index.test.mjs",
    "derive-skills": "node scripts/derive-skills.mjs",
    "check-skills": "node scripts/derive-skills.mjs --check"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
